<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Define properties -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="APP_NAME" value="delivery"/>

    <!-- Console appender with colored output for development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- JSON appender for production (structured logging) -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.contrib.json.classic.JsonLayout">
                <jsonFormatter class="ch.qos.logback.contrib.jackson.JacksonJsonFormatter">
                    <prettyPrint>false</prettyPrint>
                </jsonFormatter>
                <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampFormat>
                <appendLineSeparator>true</appendLineSeparator>
            </layout>
        </encoder>
    </appender>

    <!-- Rolling file appender for application logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Async appender for better performance -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- Error log file -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n%ex</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!-- Logger configurations for application layers -->
    <!-- ============================================ -->

    <!-- Domain layer - minimal logging (domain should be pure) -->
    <logger name="com.crafteam.delivery.domain" level="WARN"/>

    <!-- Application layer - service operations -->
    <logger name="com.crafteam.delivery.application" level="INFO"/>

    <!-- Infrastructure layer - adapters, persistence, external integrations -->
    <logger name="com.crafteam.delivery.infrastructure" level="DEBUG"/>

    <!-- Interfaces layer - REST controllers -->
    <logger name="com.crafteam.delivery.interfaces" level="INFO"/>

    <!-- ============================================ -->
    <!-- Framework loggers                            -->
    <!-- ============================================ -->

    <!-- Spring Framework -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="WARN"/>

    <!-- R2DBC and database -->
    <logger name="org.springframework.r2dbc" level="WARN"/>
    <logger name="org.springframework.data.r2dbc" level="WARN"/>
    <logger name="io.r2dbc.postgresql" level="WARN"/>
    <logger name="io.r2dbc.pool" level="WARN"/>

    <!-- Liquibase -->
    <logger name="liquibase" level="INFO"/>
    <logger name="liquibase.changelog" level="WARN"/>

    <!-- Kafka -->
    <logger name="org.springframework.kafka" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>

    <!-- Redis -->
    <logger name="org.springframework.data.redis" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>

    <!-- Reactor / WebFlux -->
    <logger name="reactor.netty" level="WARN"/>
    <logger name="io.netty" level="WARN"/>

    <!-- Hibernate Validator -->
    <logger name="org.hibernate.validator" level="WARN"/>

    <!-- MapStruct -->
    <logger name="org.mapstruct" level="WARN"/>

    <!-- ============================================ -->
    <!-- Profile-based configurations                 -->
    <!-- ============================================ -->

    <!-- Development profile -->
    <springProfile name="default,dev,local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- Enable debug for our application in dev -->
        <logger name="com.crafteam.delivery" level="DEBUG"/>
        <logger name="org.springframework.r2dbc" level="DEBUG"/>
    </springProfile>

    <!-- Production profile -->
    <springProfile name="prod,production">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>

        <logger name="com.crafteam.delivery" level="INFO"/>
    </springProfile>

    <!-- Test profile -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.crafteam.delivery" level="DEBUG"/>
    </springProfile>

</configuration>
